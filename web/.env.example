# Local / shared TEMPLATE (empty values only). For production on Vercel see:
#   .env.production.example  and  docs/vercel-env.md
# Never commit filled `.env.local` or `.env.production`.

# ── Supabase (plan §5.4) ──────────────────────────────────────────────
# Public by design: safe in the browser because RLS governs every query.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never NEXT_PUBLIC_, never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase pooler URL (port 6543) for schema migrations/psql only.
DATABASE_URL=

# ── Vercel ────────────────────────────────────────────────────────────
# Vercel-injected; protects the keep-alive cron endpoint (set in Vercel too).
CRON_SECRET=

# ── Email — Resend (plan §7) ─────────────────────────────────────────
# Also configured as Supabase Auth's custom SMTP (smtp.resend.com) in the
# Supabase dashboard — not here (plan §5.5).
RESEND_API_KEY=
TO_EMAIL=
FROM_EMAIL=

# ── Spam protection (plan §5.5) ──────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for the one-way rate-limit bucket keys. Set a long random value in
# production; keys are re-derived if you rotate it (old buckets simply expire).
RATE_LIMIT_SALT=

# ── Newsletter tokens (launch gate) ──────────────────────────────────
# HMAC secret for confirm/unsubscribe links. Without it the app runs in a
# documented degraded mode (stable non-secret fallback) — never launch on that.
NEWSLETTER_TOKEN_SECRET=

# ── Site / analytics / SEO ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
GOOGLE_SITE_VERIFICATION=

# Optional: port for the pre-deploy SEO gate (`npm run build && npm run check:seo`).
# It starts `next start` on this port locally. Default 3457. Not needed on Vercel.
SEO_CHECK_PORT=
