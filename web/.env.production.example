# Production env TEMPLATE — commit this file (empty values only).
# Real secrets go in a local gitignored `.env.production` and/or the Vercel
# project Environment Variables UI. Never commit filled secrets.
#
# How Vercel works (important):
# 1. You set env vars ONCE on the Vercel project (Production / Preview / Development).
# 2. Every Git deploy reuses them automatically — you do NOT re-enter them each deploy.
# 3. This file is NOT auto-uploaded by Git. Committing secrets here would leak them.
#
# Recommended workflow:
#   A) Fill local `.env.production` (copy from this file or from `.env.local`).
#   B) Import once: Vercel → Project → Settings → Environment Variables →
#      paste/import from `.env.production` (or use `npm run env:pull` after linking).
#   C) Keep updating secrets in Vercel (source of truth for hosted deploys).
#   D) Refresh local file anytime with: `npm run env:pull`

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Vercel cron ──────────────────────────────────────────────────────
CRON_SECRET=

# ── Email — Resend ───────────────────────────────────────────────────
RESEND_API_KEY=
TO_EMAIL=
FROM_EMAIL=

# ── Spam protection ──────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=

# ── Newsletter tokens ────────────────────────────────────────────────
NEWSLETTER_TOKEN_SECRET=

# ── Site / analytics / SEO ───────────────────────────────────────────
# Must match the final public host (no redirect). Live site uses www:
# https://www.aorysoft.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
GOOGLE_SITE_VERIFICATION=
